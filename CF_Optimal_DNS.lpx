#!name = CF 优选 DNS 更新
#!desc = 自动识别本机运营商、支持任意优选 IP 源提取与测速，并更新 Cloudflare DNS A 记录
#!author = wssder

[Argument]
isp_type = select, "V2Too_Auto", "UOUIN", "CFYes", "Mia", "WeTest", "V2Too_CM", "V2Too_CT", "V2Too_CU", "Custom_自定义", tag = [优选源]线路 API, desc = 选择内置源或 Custom_自定义；除固定 V2Too 线路外均自动识别当前运营商。
ip_count = select, "3", "1", "2", "5", tag = [DNS]优选数量, desc = 选取综合最优的前 N 个 IP。
enable_probe = switch, true, tag = [测速]手机本地二次测速, desc = 开启后通过本地直连复测延迟、抖动并过滤 Error 1034；关闭则直接使用数据源前 N 个 IP。
cf_token = input, "", tag = [Cloudflare]API Token, desc = 需要具有 Zone DNS 编辑权限。
zone_id = input, "", tag = [Cloudflare]Zone ID, desc = Cloudflare 域名 Zone ID。
record_name = input, "", tag = [DNS]域名, desc = 需要更新的完整 DNS 主机名。
custom_api = input, "https://ip.v2too.top/api/nodes?carrier={carrier}", tag = [高级]自定义 API, desc = 支持任意文本/JSON 地址、逗号拼接多源，以及 {carrier}/{CARRIER}/{isp}/{isp_cn} 占位符。
cron_exp = input, "0 4 * * *", tag = [定时]Cron, desc = 默认每天凌晨 4 点运行。

[Script]
cron {cron_exp} script-path = https://raw.githubusercontent.com/wssder/loon-js/main/Cf_Dns_Updater.js, tag = CF优选DNS更新, timeout = 180, argument = [{isp_type},{ip_count},{enable_probe},{cf_token},{zone_id},{record_name},{custom_api}]
