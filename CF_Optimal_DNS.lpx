#!name = CF 优选 DNS 多源版（测速修复）
#!desc = 多源拉取 Cloudflare 优选 IPv4，手机本地并发测速，选取最快 IP 更新 Cloudflare DNS；测速失败保留原记录。
#!author = @wssder
#!homepage = https://github.com/wssder/loon-js
#!date = 2026-11-16
#!system = iOS, iPadOS, macOS
#!loon_version = 3.5.1

[Argument]
isp_type = select, "UOUIN", "CFYes", "Mia", "WeTest", "Custom_自定义", tag = [优选源]线路 API, desc = 优先使用所选数据源；超时或返回网页时自动尝试备用纯文本 IP 源。
ip_count = select, "3", "1", "2", "5", tag = [DNS]优选数量, desc = 选取最快的前 N 个 IP。
enable_probe = switch, true, tag = [测速]手机本地二次测速, desc = 开启后使用当前网络对候选 IP 并发测速；关闭则直接取数据源前 N 个 IP。
cf_token = input, "", tag = [Cloudflare]API Token, desc = 需要具有 Zone DNS 编辑权限。
zone_id = input, "", tag = [Cloudflare]Zone ID, desc = Cloudflare 域名 Zone ID。
record_name = input, "", tag = [DNS]域名, desc = 需要更新的完整 DNS 主机名。
custom_api = input, "", tag = [高级]自定义 API, desc = 选择 Custom_自定义 时使用；每行一个 IPv4 地址或包含 IPv4 的文本。
cron_exp = input, "0 4 * * *", tag = [定时]Cron, desc = 默认每天凌晨 4 点运行。

[Script]
cron {cron_exp} script-path = https://raw.githubusercontent.com/wssder/loon-js/main/cf_dns_updater.js, tag = CF优选DNS更新, timeout = 180, argument = [{isp_type},{ip_count},{enable_probe},{cf_token},{zone_id},{record_name},{custom_api}]
